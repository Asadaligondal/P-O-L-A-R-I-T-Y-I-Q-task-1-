# Optional: enables natural-language answers grounded in retrieved rows.
# Without this key, the app still runs and shows ranked excerpts + metadata.
OPENAI_API_KEY=

# Optional override (default: gpt-4o-mini)
OPENAI_CHAT_MODEL=gpt-4o-mini

# Recommended for SEC EDGAR search calls (identify yourself per SEC policy)
SEC_USER_AGENT=YourApp/1.0 (your.email@example.com)
